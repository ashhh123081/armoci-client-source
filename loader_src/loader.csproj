<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>loader</AssemblyName>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>True</UseWindowsForms>
    <TargetFramework>net48</TargetFramework>
    <Prefer32Bit>True</Prefer32Bit>
    <LangVersion>14.0</LangVersion>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <CheckForOverflowUnderflow>False</CheckForOverflowUnderflow>
    <RootNamespace />
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Guna.UI2">
      <HintPath>Guna.UI2.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Puff.Properties.Resources.resources" LogicalName="Puff.Properties.Resources.resources" />
  </ItemGroup>
  <Target Name="StageInjectionFiles" AfterTargets="Build">
    <ItemGroup>
      <StageFiles Include="..\Vape421Injector.exe" Condition="Exists('..\Vape421Injector.exe')" />
      <StageFiles Include="..\Vape421Native.dll" Condition="Exists('..\Vape421Native.dll')" />
    </ItemGroup>
    <Copy SourceFiles="@(StageFiles)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
